      class ShipmentEditionResponseElement < Model
      end
      class ShipmentStatus < Model
        def shipment_number: () -> String?
        def created_time: () -> DateTime?
        def send_time: () -> DateTime?
        def delivery_time: () -> DateTime?
        def shipment_type: () -> String?
        def pack_count: () -> Integer?
        def shipment_description: () -> String?
        def weight: () -> Float?
        def sender_client: () -> Models::Profile::ClientProfile?
        def sender_address: () -> Models::Nomenclatures::Address?
        def receiver_client: () -> Models::Profile::ClientProfile?
        def receiver_address: () -> Models::Nomenclatures::Address?
