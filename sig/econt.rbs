        def currency: () -> String?
        def services: () -> Array[ShipmentStatusService]
        def next_shipments: () -> Array[NextShipmentElement]
        def tracking_events: () -> Array[ShipmentTrackingEvent]
        def expected_delivery_date: () -> Date?
